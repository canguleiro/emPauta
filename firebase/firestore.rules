rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorized() {
      return request.auth != null
        && (
          request.auth.uid == "SntSaG8ImRg3pbjAmC6pGqESCLH3"
          || request.auth.uid == "tWliIiH06KhVgEg4zqIZo5IeLyZ2"
        );
    }

    match /private/private-room/keys/{uid} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /private/private-room/status/{uid} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && request.auth.uid == uid;
      allow delete: if isAuthorized() && request.auth.uid == uid;
    }

    match /private/private-room/settings/{documentId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /private/private-room/messages/{messageId} {
      allow read: if isAuthorized();

      allow create: if isAuthorized()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'senderUid','senderNick','ciphertext','salt','iv','v',
          'createdAt','createdAtMs','seenBy','edited','reactions'
        ])
        && request.resource.data.ciphertext is string
        && request.resource.data.salt is string
        && request.resource.data.iv is string
        && request.resource.data.v == 2
        && request.resource.data.seenBy is list
        && request.resource.data.reactions is map;

      // O próprio remetente pode editar o conteúdo cifrado ou apagar.
      // Qualquer um dos dois pode apenas acrescentar o próprio UID a seenBy.
      allow update: if isAuthorized() && (
        (
          request.auth.uid == resource.data.senderUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ciphertext','salt','iv','v','edited'
          ])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
          && request.auth.uid in request.resource.data.seenBy
          && request.resource.data.seenBy.size() <= 2
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
        )
      );

      // Em uma conversa de duas pessoas, qualquer participante pode apagar
      // uma mensagem que tenha expirado pelo TTL. A exclusão manual na UI
      // continua disponível apenas para o remetente.
      allow delete: if isAuthorized();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
